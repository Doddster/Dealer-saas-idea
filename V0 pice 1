1|// Fetch layer over the FastAPI backend. Base is the relative "/api" prefix so the
2|// same code works in dev (Vite proxies /api → :8001) and behind a single origin in prod.
3|const BASE = "/api";
4|
5|export class ApiError extends Error {
6|  status;
7|  body;
8|  constructor(status, body) {
9|    super(`request failed with ${status}`);
10|    this.name = "ApiError";
11|    this.status = status;
12|    this.body = body;
13|  }
14|}
15|async function request(method, path, body) {
16|  // Auth rides the httpOnly session cookie automatically — never add auth headers here.
17|  const res = await fetch(`${BASE}${path}`, {
18|    method,
19|    headers:
20|      body === undefined
21|        ? undefined
22|        : {
23|            "Content-Type": "application/json",
24|          },
25|    body: body === undefined ? undefined : JSON.stringify(body),
26|  });
27|
28|  // FastAPI reports request-validation failures as 422 with a {detail: [...]} body.
29|  if (!res.ok) {
30|    const errBody = await res.json().catch(() => null);
31|    throw new ApiError(res.status, errBody);
32|  }
33|  if (res.status === 204) return undefined;
34|  return await res.json();
35|}
36|
37|// Runtime response-shape assertions belong in tests when an endpoint contract matters.
38|export const apiGet = (path) => request("GET", path);
39|export const apiPost = (path, body) => request("POST", path, body ?? null);
40|export const apiPut = (path, body) => request("PUT", path, body ?? null);
41|export const apiPatch = (path, body) => request("PATCH", path, body ?? null);
42|export const apiDelete = (path) => request("DELETE", path);
43|

