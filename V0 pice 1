5|from pathlib import Path
6|
7|from dotenv import load_dotenv
8|from motor.motor_asyncio import AsyncIOMotorClient
9|from pymongo import ASCENDING, DESCENDING, IndexModel
10|
11|load_dotenv(Path(__file__).parent.parent / ".env")
12|
13|mongo_url = os.environ["MONGO_URL"]
14|client = AsyncIOMotorClient(mongo_url)
15|db = client[os.environ["DB_NAME"]]
16|
17|logger = logging.getLogger(__name__)
18|
19|# One entry per collection: every field a route filters, sorts, or dedupes on. Applied by ensure_indexes() at startup.
20|INDEXES: dict[str, list[IndexModel]] = {
21|    "status_checks": [IndexModel([("timestamp", DESCENDING)], name="timestamp_desc")],
22|}
23|
24|
25|async def ensure_indexes() -> None:
26|    for collection, models in INDEXES.items():
27|        for model in models:  # one at a time so a bad spec skips only itself
28|            try:
29|                await db[collection].create_indexes([model])
30|            except Exception as exc:  # never block boot on an index; the log line names what to fix
31|                logger.error("ensure_indexes(%s.%s): %s", collection, model.document["name"], exc)
